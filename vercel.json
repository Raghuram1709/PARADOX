{
  "framework": "services",
  "services": {
    "paradox_frontend": {
      "bindings": [
        {
          "type": "service",
          "service": "paradox_backend",
          "format": "url",
          "env": "VITE_API_BASE_URL"
        }
      ]
    },
    "paradox_backend": {}
  },
  "builds": [
    {
      "src": "paradox_backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "paradox_backend/index.js"
    }
  ]
}
