{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "services",
  "services": {
    "paradox_frontend": {
      "root": "paradox_frontend",
      "bindings": [
        {
          "type": "service",
          "service": "paradox_backend",
          "format": "url",
          "env": "VITE_API_BASE_URL"
        }
      ]
    },
    "paradox_backend": {
      "root": "paradox_backend",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "paradox_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "paradox_frontend"
      }
    }
  ]
}
